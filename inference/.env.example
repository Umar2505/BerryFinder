# Model directory: berry_model.pt + notebook.ipynb (the code that trained it) + card.json
BERRY_MODEL_DIR=../models/nordic-gbif-1.0
# Download caches (SoilGrids index files, per-place feature tables, finished analyses). Keep it on a persistent volume.
BERRY_CACHE_DIR=.cache
# Sent to OpenStreetMap Nominatim and the open data services; include a contact address in production
BERRY_USER_AGENT=BerryFinder/1.0 (+https://github.com/Umar2505/BerryFinder)
# Browser origins allowed to call the API directly (comma-separated). Empty: server-to-server only, the default.
BERRY_ALLOWED_ORIGINS=

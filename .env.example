# BerryFinder configuration. Production secrets live in the IKON secret store (`ikon secret set NAME`); never commit real values.

# Local development only: connection string for the docker-compose PostGIS (the password is a throwaway dev value)
BERRYFINDER_DB=Host=127.0.0.1;Port=5433;Username=berryfinder;Password=berryfinder-dev-only;Database=berryfinder
BERRYFINDER_DB_PASSWORD=berryfinder-dev-only

# Secrets (IKON secret store)
# POSTGIS_URL=Host=<server>;Username=<user>;Password=<password>;Database=berryfinder;SSL Mode=Require
# NLS_API_KEY=<National Land Survey of Finland API key, for aerial imagery and terrain>

# The inference service (inference/, runs the trained model). Local default http://127.0.0.1:8090.
BERRYFINDER_INFERENCE_URL=http://127.0.0.1:8090
# Deployed: the INFERENCE_URL secret points the app at the service. Its own settings are in inference/.env.example.
# INFERENCE_URL=https://<your inference host>
